{
  "name": "proud-proxima",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build-search-index.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "search:index": "node scripts/build-search-index.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "r2:upload-assets": "node scripts/upload-r2-assets.mjs",
    "card:url": "node scripts/card-url.mjs",
    "lint:text": "textlint \"src/content/**/*.md\"",
    "lint:text:fix": "textlint --fix \"src/content/**/*.md\"",
    "prepare": "husky",
    "build:deploy": "pnpm run fonts:subset && pnpm --filter slides run build && pnpm run build && pnpm run r2:rewrite-html",
    "check": "void prepare && astro sync && tsc --noEmit",
    "deploy": "void deploy --platform cloudflare",
    "r2:rewrite-html": "R2_ASSET_UPLOAD=0 node scripts/upload-r2-assets.mjs"
  },
  "lint-staged": {
    "src/content/**/*.md": "textlint"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "astro": "^7.4.5",
    "beautiful-mermaid": "^1.1.3",
    "gray-matter": "^4.0.3",
    "kuromoji": "^0.1.2",
    "sharp": "^0.34.2",
    "unist-util-visit": "^5.1.0",
    "@astrojs/cloudflare": "^14.4.4"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "wrangler": "^4.125.0",
    "void": "1.6.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^24.22.0 || >=26.12.0"
  }
}
