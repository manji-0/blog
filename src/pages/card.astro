---
import { Picture } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import avatar from '../assets/card/manji0.jpg';

const profile = {
	name: '萬治 渉',
	handle: 'manji0',
	nickname: 'まんじまる',
	email: 'manji@linux.com',
};

const links = [
	{
		label: 'Email',
		value: profile.email,
		href: `mailto:${profile.email}`,
		icon: 'email',
	},
	{
		label: 'GitHub',
		value: 'github.com/manji-0',
		href: 'https://github.com/manji-0',
		icon: 'github',
	},
	{
		label: 'X',
		value: 'x.com/_manji0',
		href: 'https://x.com/_manji0',
		icon: 'x.com',
	},
	{
		label: 'Fediverse',
		value: '@manji0@fedi.manji.app',
		href: 'https://fedi.manji.app/users/manji0',
		icon: 'mastodon',
	},
] as const;

const vcard = [
	'BEGIN:VCARD',
	'VERSION:3.0',
	'N:萬治;渉;;;',
	`FN:${profile.name}`,
	`NICKNAME:${profile.handle}`,
	`EMAIL;TYPE=INTERNET:${profile.email}`,
	'URL:https://www.manj.io/',
	'URL:https://github.com/manji-0',
	'URL:https://x.com/_manji0',
	'URL:https://fedi.manji.app/users/manji0',
	'END:VCARD',
].join('\r\n');
const vcardHref = `data:text/vcard;charset=utf-8,${encodeURIComponent(vcard)}`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta name="referrer" content="no-referrer" />
		<meta name="theme-color" content="#0c1318" />
		<title>{profile.handle} | manj.io</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="stylesheet" href="/fonts/fonts.css" />
	</head>
	<body>
		<main class="card">
			<div class="window">
				<header class="titlebar">
					<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="title">~/whoami</span>
					<span class="status"><span class="led" aria-hidden="true"></span>online</span>
				</header>

				<section class="hero">
					<div class="avatar">
						<Picture
							src={avatar}
							formats={['avif']}
							fallbackFormat="webp"
							alt="manji0 のアバター（ピクセルアート）"
							width={320}
							height={320}
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<p class="prompt"><span class="caret">$</span> whoami</p>
					<h1 class="name">{profile.name}</h1>
					<p class="handle">
						<span class="at">@</span>{profile.handle}
						<span class="nick">（{profile.nickname}）</span>
					</p>
				</section>

				<nav class="links" aria-label="連絡先">
					{
						links.map((link) => (
							<a class="link" href={link.href} rel="noopener noreferrer" target={link.href.startsWith('http') ? '_blank' : undefined}>
								<span class="link-icon">
									<Icon name={link.icon} size="1.25rem" />
								</span>
								<span class="link-body">
									<span class="link-label">{link.label}</span>
									<span class="link-value">{link.value}</span>
								</span>
								<span class="link-arrow" aria-hidden="true">
									→
								</span>
							</a>
						))
					}
				</nav>

				<a class="save" href={vcardHref} download="manji0.vcf">
					<span class="caret">&gt;</span> 連絡先を保存 (.vcf)
				</a>

				<footer class="foot">
					<a href="https://www.manj.io/">manj.io</a>
					<span aria-hidden="true">·</span>
					<span>tapped via NFC</span>
				</footer>
			</div>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: hsl(205, 31%, 7%);
		--panel: hsl(205, 24%, 10%);
		--panel-2: hsl(205, 21%, 13%);
		--line: hsl(203, 19%, 19%);
		--text: hsl(205, 18%, 86%);
		--muted: hsl(205, 11%, 58%);
		--accent: hsl(213, 90%, 66%);
		--accent-high: hsl(205, 80%, 82%);
		--accent-low: hsla(213, 90%, 66%, 0.14);
		--silver: hsl(210, 10%, 88%);
		--grid: hsla(199, 80%, 75%, 0.045);
		--mono: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace;
		--sans: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic UI', system-ui, sans-serif;
		color-scheme: dark;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: max(1.25rem, env(safe-area-inset-top)) 1rem max(1.25rem, env(safe-area-inset-bottom));
		background:
			radial-gradient(60rem 30rem at 50% -10%, var(--accent-low), transparent 60%),
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px),
			var(--bg);
		background-size: auto, 28px 28px, 28px 28px, auto;
		color: var(--text);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}
</style>

<style>
	.card {
		width: 100%;
		max-width: 26rem;
	}

	.window {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow:
			0 0 0 1px hsla(0, 0%, 0%, 0.3),
			0 24px 60px -20px hsla(0, 0%, 0%, 0.6);
		animation: boot 420ms ease-out both;
	}

	.titlebar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid var(--line);
		background: var(--panel-2);
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
	}

	.dots {
		display: inline-flex;
		gap: 0.35rem;
	}

	.dots i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--line);
	}

	.title {
		flex: 1;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--accent);
	}

	.led {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
		animation: pulse 2.4s ease-in-out infinite;
	}

	.hero {
		padding: 1.75rem 1.5rem 1.25rem;
		text-align: center;
	}

	.avatar {
		width: 9.5rem;
		height: 9.5rem;
		margin: 0 auto 1.25rem;
		overflow: hidden;
		padding: 0.35rem;
		background: #fbfaf9;
		border: 2px solid var(--silver);
		box-shadow:
			4px 4px 0 0 var(--accent),
			4px 4px 0 2px var(--bg);
	}

	.avatar :global(picture) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.avatar :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
		transform: scale(1.35);
		transform-origin: 50% 35%;
	}

	.prompt {
		margin: 0 0 0.35rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.caret {
		color: var(--accent);
	}

	.name {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: hsl(0, 0%, 100%);
	}

	.handle {
		margin: 0.85rem 0 0;
		font-family: var(--mono);
		font-size: 1rem;
		color: var(--silver);
	}

	.at {
		margin-right: 0.15em;
		color: var(--accent-high);
	}

	.nick {
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--muted);
	}

	.links {
		display: grid;
		gap: 0.5rem;
		padding: 0 1rem;
	}

	.link {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-height: 3.5rem;
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--panel-2);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 120ms,
			background 120ms,
			transform 120ms;
	}

	.link:hover,
	.link:focus-visible {
		border-color: var(--accent);
		background: var(--accent-low);
		outline: none;
	}

	.link:active {
		transform: scale(0.985);
	}

	.link-icon {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		flex: none;
		border-radius: 0.4rem;
		background: var(--bg);
		color: var(--accent);
	}

	.link-body {
		display: grid;
		min-width: 0;
		flex: 1;
	}

	.link-label {
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.link-value {
		overflow: hidden;
		font-family: var(--mono);
		font-size: 0.88rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.link-arrow {
		color: var(--muted);
		font-family: var(--mono);
	}

	.link:hover .link-arrow {
		color: var(--accent);
	}

	.save {
		display: block;
		margin: 1rem 1rem 0;
		padding: 0.8rem;
		border-radius: 0.5rem;
		background: var(--accent);
		color: hsl(205, 31%, 7%);
		font-family: var(--mono);
		font-size: 0.9rem;
		font-weight: 700;
		text-align: center;
		text-decoration: none;
	}

	.save .caret {
		color: inherit;
	}

	.save:active {
		transform: scale(0.985);
	}

	.foot {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		padding: 1.1rem 1rem 1.25rem;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}

	.foot a {
		color: inherit;
	}

	@keyframes boot {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.window,
		.led {
			animation: none;
		}
	}
</style>
