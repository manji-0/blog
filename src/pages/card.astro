---
import { Picture } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import avatar from '../assets/card/manji0.jpg';

const profile = {
	name: '萬治 渉',
	handle: 'manji0',
	nickname: 'まんじまる',
	email: 'manji@linux.com',
	workEmail: 'w.manji@kakehashi.life',
	org: 'KAKEHASHI Inc.',
};

const links = [
	{
		label: 'Email',
		value: profile.email,
		href: `mailto:${profile.email}`,
		copy: profile.email,
		icon: 'email',
	},
	{
		label: 'Email (Work)',
		value: profile.workEmail,
		href: `mailto:${profile.workEmail}`,
		copy: profile.workEmail,
		icon: 'email',
	},
	{
		label: 'GitHub',
		value: 'github.com/manji-0',
		href: 'https://github.com/manji-0',
		copy: 'https://github.com/manji-0',
		icon: 'github',
	},
	{
		label: 'X',
		value: 'x.com/_manji0',
		href: 'https://x.com/_manji0',
		copy: 'https://x.com/_manji0',
		icon: 'x.com',
	},
	{
		label: 'Fediverse',
		value: '@manji0@fedi.manji.app',
		href: 'https://fedi.manji.app/users/manji0',
		copy: '@manji0@fedi.manji.app',
		icon: 'mastodon',
	},
] as const;

const vcard = [
	'BEGIN:VCARD',
	'VERSION:3.0',
	'N:萬治;渉;;;',
	`FN:${profile.name}`,
	`NICKNAME:${profile.handle}`,
	`ORG:${profile.org}`,
	`EMAIL;TYPE=INTERNET,HOME:${profile.email}`,
	`EMAIL;TYPE=INTERNET,WORK:${profile.workEmail}`,
	'URL:https://www.manj.io/',
	'URL:https://github.com/manji-0',
	'URL:https://x.com/_manji0',
	'URL:https://fedi.manji.app/users/manji0',
	'END:VCARD',
].join('\r\n');
const vcardHref = `data:text/vcard;charset=utf-8,${encodeURIComponent(vcard)}`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta name="referrer" content="no-referrer" />
		<meta name="theme-color" content="#0c1318" />
		<title>{profile.handle} | manj.io</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="stylesheet" href="/fonts/fonts.css" />
	</head>
	<body>
		<main class="card">
			<div class="window">
				<header class="titlebar">
					<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="title">~/whoami</span>
					<span class="status"><span class="led" aria-hidden="true"></span>online</span>
				</header>

				<section class="hero">
					<div class="avatar">
						<Picture
							src={avatar}
							formats={['avif']}
							fallbackFormat="webp"
							alt="manji0 のアバター（ピクセルアート）"
							width={320}
							height={320}
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<p class="prompt"><span class="caret">$</span> whoami</p>
					<h1 class="name">{profile.name}</h1>
					<p class="handle">
						<span class="at">@</span>{profile.handle}
						<span class="nick">（{profile.nickname}）</span>
					</p>
				</section>

				<nav class="links" aria-label="連絡先">
					{
						links.map((link) => (
							<div class="row">
								<a class="link" href={link.href} rel="noopener noreferrer" target={link.href.startsWith('http') ? '_blank' : undefined}>
									<span class="link-icon">
										<Icon name={link.icon} size="1.25rem" />
									</span>
									<span class="link-body">
										<span class="link-label">{link.label}</span>
										<span class="link-value">{link.value}</span>
									</span>
								</a>
								<button class="copy" type="button" data-copy={link.copy} aria-label={`${link.label} をコピー`}>
									<svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true">
										<rect x="9" y="9" width="11" height="11" rx="2" />
										<path d="M5 15V6a2 2 0 0 1 2-2h9" />
									</svg>
									<svg class="done-icon" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M5 12.5l4.5 4.5L19 7.5" />
									</svg>
								</button>
							</div>
						))
					}
				</nav>
				<p class="toast" role="status" aria-live="polite"></p>

				<a class="save" href={vcardHref} download="manji0.vcf">
					<span class="caret">&gt;</span> 連絡先を保存 (.vcf)
				</a>

				<footer class="foot">
					<a href="https://www.manj.io/">manj.io</a>
					<span aria-hidden="true">·</span>
					<span>tapped via NFC</span>
				</footer>
			</div>
		</main>
		<script>
			const COPIED_MS = 1600;
			const toast = document.querySelector<HTMLElement>('.toast');
			let toastTimer: number | undefined;

			function copyWithSelection(text: string): boolean {
				const area = document.createElement('textarea');
				area.value = text;
				area.setAttribute('readonly', '');
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.append(area);
				area.select();
				const ok = document.execCommand('copy');
				area.remove();
				return ok;
			}

			async function copyText(text: string): Promise<boolean> {
				try {
					await navigator.clipboard.writeText(text);
					return true;
				} catch {
					return copyWithSelection(text);
				}
			}

			function showToast(message: string) {
				if (!toast) return;
				toast.textContent = message;
				toast.classList.add('is-visible');
				window.clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), COPIED_MS);
			}

			for (const button of document.querySelectorAll<HTMLButtonElement>('.copy')) {
				button.addEventListener('click', async () => {
					const text = button.dataset.copy ?? '';
					if (!(await copyText(text))) {
						showToast('コピーできませんでした');
						return;
					}
					button.classList.add('is-copied');
					showToast(`コピーしました: ${text}`);
					window.setTimeout(() => button.classList.remove('is-copied'), COPIED_MS);
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: hsl(205, 31%, 7%);
		--panel: hsl(205, 24%, 10%);
		--panel-2: hsl(205, 21%, 13%);
		--line: hsl(203, 19%, 19%);
		--text: hsl(205, 18%, 86%);
		--muted: hsl(205, 11%, 58%);
		--accent: hsl(213, 90%, 66%);
		--accent-high: hsl(205, 80%, 82%);
		--accent-low: hsla(213, 90%, 66%, 0.14);
		--silver: hsl(210, 10%, 88%);
		--grid: hsla(199, 80%, 75%, 0.045);
		--mono: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace;
		--sans: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic UI', system-ui, sans-serif;
		color-scheme: dark;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: max(1.25rem, env(safe-area-inset-top)) 1rem max(1.25rem, env(safe-area-inset-bottom));
		background:
			radial-gradient(60rem 30rem at 50% -10%, var(--accent-low), transparent 60%),
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px),
			var(--bg);
		background-size: auto, 28px 28px, 28px 28px, auto;
		color: var(--text);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}
</style>

<style>
	.card {
		width: 100%;
		max-width: 26rem;
	}

	.window {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow:
			0 0 0 1px hsla(0, 0%, 0%, 0.3),
			0 24px 60px -20px hsla(0, 0%, 0%, 0.6);
		animation: boot 420ms ease-out both;
	}

	.titlebar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid var(--line);
		background: var(--panel-2);
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
	}

	.dots {
		display: inline-flex;
		gap: 0.35rem;
	}

	.dots i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--line);
	}

	.title {
		flex: 1;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--accent);
	}

	.led {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
		animation: pulse 2.4s ease-in-out infinite;
	}

	.hero {
		padding: 1.75rem 1.5rem 1.25rem;
		text-align: center;
	}

	.avatar {
		width: 9.5rem;
		height: 9.5rem;
		margin: 0 auto 1.25rem;
		overflow: hidden;
		padding: 0.35rem;
		background: #fbfaf9;
		border: 2px solid var(--silver);
		box-shadow:
			4px 4px 0 0 var(--accent),
			4px 4px 0 2px var(--bg);
	}

	.avatar :global(picture) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.avatar :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
		transform: scale(1.35);
		transform-origin: 50% 35%;
	}

	.prompt {
		margin: 0 0 0.35rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.caret {
		color: var(--accent);
	}

	.name {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: hsl(0, 0%, 100%);
	}

	.handle {
		margin: 0.85rem 0 0;
		font-family: var(--mono);
		font-size: 1rem;
		color: var(--silver);
	}

	.at {
		margin-right: 0.15em;
		color: var(--accent-high);
	}

	.nick {
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--muted);
	}

	.links {
		display: grid;
		gap: 0.5rem;
		padding: 0 1rem;
	}

	.row {
		display: flex;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--panel-2);
		transition: border-color 120ms;
	}

	.row:has(:hover, :focus-visible) {
		border-color: var(--accent);
	}

	.link {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
		min-height: 3.5rem;
		flex: 1;
		padding: 0.6rem 0.9rem;
		color: inherit;
		text-decoration: none;
		transition: background 120ms;
	}

	.link:hover,
	.link:focus-visible,
	.copy:hover,
	.copy:focus-visible {
		background: var(--accent-low);
		outline: none;
	}

	.link:active,
	.copy:active {
		background: hsla(213, 90%, 66%, 0.24);
	}

	.copy {
		display: grid;
		place-items: center;
		width: 3.25rem;
		flex: none;
		padding: 0;
		border: 0;
		border-left: 1px solid var(--line);
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition:
			background 120ms,
			color 120ms;
	}

	.copy:hover,
	.copy:focus-visible {
		color: var(--accent);
	}

	.copy svg {
		grid-area: 1 / 1;
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			opacity 150ms,
			transform 150ms;
	}

	.done-icon {
		opacity: 0;
		transform: scale(0.6);
	}

	.copy.is-copied {
		color: var(--accent);
	}

	.copy.is-copied .copy-icon {
		opacity: 0;
		transform: scale(0.6);
	}

	.copy.is-copied .done-icon {
		opacity: 1;
		transform: none;
	}

	.toast {
		position: fixed;
		left: 50%;
		bottom: max(1.5rem, env(safe-area-inset-bottom));
		z-index: 10;
		margin: 0;
		padding: 0.55rem 1rem;
		border: 1px solid var(--accent);
		border-radius: 999px;
		background: var(--panel-2);
		color: var(--text);
		font-family: var(--mono);
		font-size: 0.8rem;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, 0.5rem);
		transition:
			opacity 150ms,
			transform 150ms;
	}

	.toast.is-visible {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.link-icon {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		flex: none;
		border-radius: 0.4rem;
		background: var(--bg);
		color: var(--accent);
	}

	.link-body {
		display: grid;
		min-width: 0;
		flex: 1;
	}

	.link-label {
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.link-value {
		overflow: hidden;
		font-family: var(--mono);
		font-size: 0.88rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.save {
		display: block;
		margin: 1rem 1rem 0;
		padding: 0.8rem;
		border-radius: 0.5rem;
		background: var(--accent);
		color: hsl(205, 31%, 7%);
		font-family: var(--mono);
		font-size: 0.9rem;
		font-weight: 700;
		text-align: center;
		text-decoration: none;
	}

	.save .caret {
		color: inherit;
	}

	.save:active {
		transform: scale(0.985);
	}

	.foot {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		padding: 1.1rem 1rem 1.25rem;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}

	.foot a {
		color: inherit;
	}

	@keyframes boot {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.window,
		.led {
			animation: none;
		}
	}
</style>
